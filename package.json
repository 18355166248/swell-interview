{
  "name": "swell-interview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "dev:desktop": "node scripts/desktop-dev.mjs",
    "build:desktop": "npm run build && npm run build:electron",
    "build:electron": "tsc -p tsconfig.electron.json",
    "desktop": "npm run build:desktop && electron .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run tests/study.test.ts && npm run test:content",
    "mobile:sync": "npm run build && cap sync",
    "mobile:add:ios": "cap add ios",
    "mobile:add:android": "cap add android",
    "mobile:ios": "cap open ios",
    "mobile:android": "cap open android",
    "curation:check": "python3 question-bank/tools/curate.py --bank question-bank",
    "test:content": "node --test tests/question-examples.test.mjs && python3 -m unittest discover -s tests -p 'test_curation.py'",
    "ios": "node scripts/ios-device-run.mjs",
    "ios:check": "node scripts/ios-device-run.mjs --dry-run"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.0",
    "@capacitor/core": "^7.6.0",
    "@capacitor/ios": "^7.6.0",
    "@mantine/code-highlight": "^9.7.4",
    "@mantine/core": "9.7.4",
    "@mantine/hooks": "9.7.4",
    "@mantine/notifications": "9.7.4",
    "@tabler/icons-react": "^3.35.0",
    "@vitejs/plugin-react": "5.0.4",
    "highlight.js": "^11.12.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "^7.9.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "^38.8.6",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  },
  "description": "面试拾光：共享 React UI 的前端面试学习应用",
  "main": "dist-electron/main.cjs"
}
